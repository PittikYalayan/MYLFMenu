-- Cache (ultra opti)
local LastPart = nil
local LastDisplayName = ""
local LastPath = ""
local LastRainbow = nil

-- İsim bul
local function GetDisplayName(Part)
    local Model = Part:FindFirstAncestorWhichIsA("Model")
    if Model then
        local Player = Players:GetPlayerFromCharacter(Model)
        if Player then return Player.DisplayName end
        return Model.Name
    end
    return Part.Name
end

-- Tam path hesapla (hızlı, cache'li)
local function GetFullPath(Part)
    local path = {}
    local current = Part
    while current do
        table.insert(path, 1, current.Name)
        current = current.Parent
    end
    return table.concat(path, ".")
end

-- Loop (RenderStepped 0ms/frame sync god)
RunService.RenderStepped:Connect(function()
    local TargetPart = Mouse.Target
    
    if TargetPart and TargetPart:IsA("BasePart") and not TargetPart:IsA("Terrain") then
        local Model = TargetPart:FindFirstAncestorWhichIsA("Model")
        if Model and Model ~= LocalPlayer.Character then
            local DisplayName = GetDisplayName(TargetPart)
            local FullPath = GetFullPath(TargetPart)
            
            -- Same part? Sadece rainbow (opti max)
            if TargetPart == LastPart and DisplayName == LastDisplayName and FullPath == LastPath then
                local Hue = (tick() % 8) / 8
                local Rainbow = Color3.fromHSV(Hue, 1, 1)
                if Rainbow ~= LastRainbow then
                    Highlight.FillColor = Rainbow
                    Highlight.OutlineColor = Rainbow
                    NameLabel.TextColor3 = Rainbow
                    PathLabel.TextColor3 = Rainbow
                    LastRainbow = Rainbow
                end
                return
            end
            
            -- New part: Full update
            local Hue = (tick() % 8) / 8
            local Rainbow = Color3.fromHSV(Hue, 1, 1)
            LastRainbow = Rainbow
            
            Highlight.Adornee = TargetPart
            Highlight.FillColor = Rainbow
            Highlight.OutlineColor = Rainbow
            Highlight.Enabled = true
            
            NameLabel.Text = DisplayName
            PathLabel.Text = FullPath
            NameLabel.TextColor3 = Rainbow
            PathLabel.TextColor3 = Rainbow
            
            Billboard.Adornee = TargetPart
            Billboard.Enabled = true
            
            LastPart = TargetPart
            LastDisplayName = DisplayName
            LastPath = FullPath
        else
            -- Local char: Hide
            if LastPart then
                Highlight.Enabled = false
                Billboard.Enabled = false
                LastPart = nil
            end
        end
    else
        -- No valid: Hide
        if LastPart then
            Highlight.Enabled = false
            Billboard.Enabled = false
            LastPart = nil
        end
    end
end)
